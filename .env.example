# 复制为 .env 后按需修改；docker compose 会自动读取
# 宿主发布端口（验证环境由 CC_PUBLISH_PORT 注入，本地可自定义）
CC_PUBLISH_PORT=8080

# 数据库（仅 compose 内部网络访问，不发布到宿主）
DB_NAME=scaleguard
DB_USER=scaleguard
DB_PASSWORD=scaleguard

# 是否初始化演示数据（true/false）
SEED_DEMO=true

# 会话签名密钥，生产环境务必修改
SESSION_SECRET=dev-secret-change-me-0123456789abcdef
